set -e -x

if [ -z "$BOSH_PACKAGES_DIR" ]; then
  pkg_dir=$(readlink -nf /var/vcap/packages/golang-1-linux)
else
  pkg_dir=$BOSH_PACKAGES_DIR/golang-1-linux
fi

source ${pkg_dir}/bosh/compile.env

# Install libvirt development headers (needed for CGO compilation) and the
# runtime library.  Running apt-get here is safe: BOSH compiles packages on
# the target VM which has internet access on GHA runners.
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y --no-install-recommends libvirt-dev libvirt0

export CGO_ENABLED=1

mkdir -p /tmp/go/.cache
export GOPATH=/tmp/go
export GOCACHE=${GOPATH}/.cache

cd ${BOSH_COMPILE_TARGET}/bosh-libvirt-cpi
mkdir -p ${BOSH_INSTALL_TARGET}/bin

export GOARCH=amd64
export GOOS=linux

# Build without libvirt_dlopen: libvirt-dev is now installed so we can link
# against the system libvirt.so at compile time.  libvirt0 installed above
# provides the runtime library in the standard system path (/usr/lib/...) so
# LD_LIBRARY_PATH manipulation is unnecessary.
go build -mod=vendor -o ${BOSH_INSTALL_TARGET}/bin/cpi ./main/*.go
