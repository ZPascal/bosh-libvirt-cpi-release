set -e -x

if [ -z "$BOSH_PACKAGES_DIR" ]; then
  pkg_dir=$(readlink -nf /var/vcap/packages/golang-1-linux)
else
  pkg_dir=$BOSH_PACKAGES_DIR/golang-1-linux
fi

source ${pkg_dir}/bosh/compile.env

# libvirt_dlopen: load libvirt.so at runtime via dlopen instead of linking
# at compile time. This avoids needing pkg-config/libvirt-dev headers in
# the stemcell during BOSH package compilation.
export CGO_ENABLED=1

mkdir -p /tmp/go/.cache
export GOPATH=/tmp/go
export GOCACHE=${GOPATH}/.cache

cd ${BOSH_COMPILE_TARGET}/bosh-libvirt-cpi
mkdir -p ${BOSH_INSTALL_TARGET}/bin

export GOARCH=amd64
export GOOS=linux

go build -mod=vendor -tags libvirt_dlopen -o ${BOSH_INSTALL_TARGET}/bin/cpi ./main/*.go
