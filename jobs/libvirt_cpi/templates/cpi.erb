#!/bin/bash

BOSH_PACKAGES_DIR=${BOSH_PACKAGES_DIR:-/var/vcap/packages}
BOSH_JOBS_DIR=${BOSH_JOBS_DIR:-/var/vcap/jobs}

<% if_p('env.http_proxy') do |http_proxy| %>
export HTTP_PROXY=<%= http_proxy.shellescape %>
export http_proxy=<%= http_proxy.shellescape %>
<% end %>

<% if_p('env.https_proxy') do |https_proxy| %>
export HTTPS_PROXY=<%= https_proxy.shellescape %>
export https_proxy=<%= https_proxy.shellescape %>
<% end %>

<% if_p('env.no_proxy') do |no_proxy| %>
export NO_PROXY=<%= no_proxy.shellescape %>
export no_proxy=<%= no_proxy.shellescape %>
<% end %>

# Prepend the bundled libvirt.so.0 so the CPI works inside BOSH VMs that
# don't have libvirt0 installed (e.g. the Ubuntu Jammy warden stemcell).
export LD_LIBRARY_PATH=$BOSH_PACKAGES_DIR/libvirt_cpi/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}

exec $BOSH_PACKAGES_DIR/libvirt_cpi/bin/cpi -configPath $BOSH_JOBS_DIR/libvirt_cpi/config/cpi.json
