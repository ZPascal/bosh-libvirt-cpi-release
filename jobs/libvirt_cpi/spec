---
name: libvirt_cpi

templates:
  cpi.erb: bin/cpi
  cpi.json.erb: config/cpi.json

packages:
- libvirt_cpi

properties:
  backend_uri:
    description: >
      Libvirt connection URI. Determines the hypervisor backend.
      Examples: "qemu:///system" (QEMU/KVM), "lxc:///" (LXC),
      "vbox:///session" (VirtualBox).
    default: "qemu:///system"

  host:
    description: >
      Hostname or IP of the machine running libvirtd.
      If not set, the CPI connects to the local libvirtd via the backend_uri.
    default: ""
    example: 192.168.50.1

  port:
    description: SSH port for connecting to the libvirt host. Only used when host is set.
    default: 22

  username:
    description: Username for SSH access to the libvirt host. Required when host is set.
    default: ""

  private_key:
    description: SSH private key (PEM format) for accessing the libvirt host. Required when host is set.
    default: ""

  host_key:
    description: >
      SSH host public key in authorized_keys format (e.g. "ssh-ed25519 AAAA...").
      Required when host is set. Used to verify the remote host identity.
    default: ""

  store_dir:
    description: >
      Directory on the libvirt host used to store stemcells, disks, and VM metadata.
      The '~' prefix is expanded to the connecting user's home directory.
    default: "~/.bosh_libvirt_cpi"

  inject_backend_uri:
    description: >
      Libvirt connection URI for the deployed director's CPI. Injected at create_vm time
      so the agent-rendered cpi.json (which defaults to qemu:///system) is overwritten
      with the correct backend. Falls back to backend_uri if unset.
    default: ""
  inject_host:
    description: >
      SSH host for the deployed director's CPI to use when tunnelling to libvirtd.
      Injected into the VM rootfs at create_vm time so the agent-rendered cpi.json
      is overwritten with correct credentials on first boot. Falls back to host if unset.
    default: ""
  inject_username:
    description: SSH username for inject_host. Falls back to username if unset.
    default: ""
  inject_private_key:
    description: SSH private key (PEM) for inject_host. Falls back to private_key if unset.
    default: ""
  inject_host_key:
    description: SSH host public key for inject_host in authorized_keys format. Falls back to host_key if unset.
    default: ""
  inject_store_dir:
    description: >
      store_dir for the deployed director's CPI. Injected at create_vm time.
      Falls back to store_dir if unset.
    default: ""

  ntp:
    description: List of NTP server addresses for the BOSH agent.
    default:
      - 0.pool.ntp.org
      - 1.pool.ntp.org

  agent.mbus:
    description: Agent mbus URL (NATS or HTTPS).

  nats.user:
    description: NATS username.
    default: nats
  nats.password:
    description: NATS password.
  agent.nats.address:
    description: NATS server address (used by agent).
  nats.address:
    description: NATS server address.
  nats.port:
    description: NATS server port.
    default: 4222

  env.http_proxy:
    description: HTTP proxy for outbound connections.
  env.https_proxy:
    description: HTTPS proxy for outbound connections.
  env.no_proxy:
    description: Comma-separated list of hosts to bypass the proxy.

  mbus_bootstrap_ssl.ca:
    description: CA certificate for the mbus bootstrap TLS listener (from mbus_bootstrap_ssl variable).
    default: ""
  mbus_bootstrap_ssl.certificate:
    description: Certificate for the mbus bootstrap TLS listener.
    default: ""
  mbus_bootstrap_ssl.private_key:
    description: Private key for the mbus bootstrap TLS listener.
    default: ""
